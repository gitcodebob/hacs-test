{
  "name": "Home Assistant Dev",
  "dockerComposeFile": "docker-compose.yml",
  "service": "ha-dev",
  "workspaceFolder": "/config",
  "forwardPorts": [
    8123,
    1880
  ],
  "remoteUser": "root",
  "overrideCommand": false,
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "redhat.vscode-yaml",
        "keesschollaart.vscode-home-assistant"
      ]
    }
  }
}